# ════════════ ВЕБ-IDE ════════════
PASSWORD=                   # пароль входа в IDE; пусто = сгенерируется и покажется в логах
AUTH=password               # password | none
PORT=8080                   # порт code-server (и публикации на хосте)
BIND=127.0.0.1              # адрес на хосте для порта (0.0.0.0 = слушать все интерфейсы)
IDE_HOME=./ide-home         # путь на хосте: домашняя папка IDE (настройки, расширения, ~/.claude)

# часовой пояс машины с IDE (см. ls /usr/share/zoneinfo): Europe/Moscow, Asia/Tbilisi, ...
TZ=UTC
# локаль: сначала сгенерируйте через LOCALE, затем LANG/LC_ALL прокинутся в окружение автоматически
# LOCALE=ru_RU.UTF-8
# LANG=ru_RU.UTF-8

# git-identity (опционально)
# GIT_USER_NAME=Ivan Ivanov
# GIT_USER_EMAIL=ivan@example.com

WORKSPACE=/root/workspace   # стартовая папка, открывающаяся в IDE
# CS_ARGS=--cert /path/to/cert  — любые доп. флаги code-server (напр. свой TLS-сертификат)
# IDE_EXTENSIONS=ms-python.python,golang.Go — расширения VS Code при первом старте

# ════════════ ТУЛЧЕЙНЫ (JDK и прочее) ════════════
# SDKMAN предустановлен. Любые JDK (Temurin/Corretto/GraalVM...), Maven,
# Gradle, Kotlin, Scala. Формат: "кандидат:версия" через запятую; версия
# опциональна (последняя stable). Список версий: в терминале IDE `sdk list java`
# SDK_PKGS=java:21.0.5-tem,java:17.0.13-tem,maven:3.9.9,gradle:8.10
# Первый java из списка станет дефолтным (JAVA_HOME). Ставится в ~/.sdkman —
# на диск хоста (IDE_HOME), переживает пересборку.
# Любые apt-пакеты при старте контейнера:
# EXTRA_APT_PACKAGES=postgresql-client redis-tools
# INSTALL_SCRIPTS=0         # 1 (дефолт) = выполнять исполняемые *.sh из install.d/
# TB_UPGRADE_DAYS=7         # как часто install.d/terminal-browser.sh проверяет обновления
#                           # (0 = каждый старт; само приложение качается только один раз)

# ════════════ ПЛАГИНЫ И АГЕНТЫ CLAUDE CODE ════════════
# Плагины — декларативно (ставятся при старте, идемпотентно, в ~/.claude/plugins):
# CLAUDE_MARKETPLACES=obra/superpowers-marketplace,JaimeJunr/claude-code-frontend-skills,mishgoldenberg/claude-mods,Leonxlnx/taste-skill,freshtechbro/claudedesignskills,anthropics/skills
# CLAUDE_PLUGINS=superpowers@superpowers-marketplace,frontend-design@frontend-stack,impeccable@frontend-stack,emil-design-eng@frontend-stack,playwright@claude-plugins-official,loop-breaker@claude-mods,taste-skill@taste-skill,animation-components@claude-design-skillstack,document-skills@anthropic-agent-skills
# Субагенты/команды/настройки/MCP — это ФАЙЛЫ, кладите напрямую в ide-home:
#   ide-home/.claude/agents/*.md        — субагенты
#   ide-home/.claude/commands/*.md      — кастомные команды
#   ide-home/.claude/settings.json      — permissions, hooks
#   ide-home/.claude.json               — OAuth, MCP-серверы (mcpServers)
# На уровне проекта: папка .claude\ в workspace (уедет в git проекта).
# расширение Claude Code: по умолчанию держится СВЕЖИМ автоматически —
# при старте: claude update (CLI с npm, мгновенный паблиш) +
# переустановка расширения через штатную галерею code-server
# CLAUDE_EXTENSION_AUTOUPDATE=0  # не обновлять при старте (расширение всё равно поставится, если отсутствует)
# CLAUDE_EXTENSION_REFRESH=1     # переустанавливать расширение ВСЕГДА

# ════════════ VPN/PROXY (только sidecar) ════════════
# FAIL-CLOSED: без рабочего туннеля контейнер НЕ ИМЕЕТ выхода в интернет.
# direct-режим = полная изоляция (air-gap), доступен только IDE-порт.
# auto: если в ./wireguard лежит *.conf — wireguard, иначе PROXY_URL, иначе direct(изолирован)
PROXY_MODE=auto
# socks5://user:pass@host:1080 | http://user:pass@host:8080
PROXY_URL=
T2S_LOGLEVEL=warn           # debug|info|warn|error|silent — лог tun2socks
# NET_HOOK=/config/wireguard/hooks/after-up.sh — скрипт после поднятия сети.
# Кладите его в ./wireguard/hooks/ и делайте chmod +x (это единственный путь,
# смонтированный в vpn-контейнер). Есть готовый пример: wireguard/hooks/after-up.sh.example

# DNS-резолверы (compose dns:). В proxy/wg-режимах запросы идут через туннель;
# для http-прокси без UDP — LAN-резолвер, напр. 192.168.1.1. НЕ убирайте dns: из compose!
DNS1=8.8.8.8
DNS2=1.1.1.1

# ════════════ БРАУЗЕР В КОНТЕЙНЕРЕ ════════════
# Поднимается вместе со стеком; открывается на хосте:
#   http://localhost:6080/  (порт меняется тут)
BROWSER_PORT=6080
BROWSER_BIND=127.0.0.1        # 0.0.0.0 = доступ из локальной сети — тогда ОБЯЗАТЕЛЬНО VNC_PASSWORD
# Удобно для OAuth-логинов целиком внутри контейнера (вкл. localhost-callback)
# и для любого серфинга через туннель.
# VNC_PASSWORD=                 # пароль на noVNC; пусто = без (порт на 127.0.0.1)
# BROWSER_START_URL=https://claude.ai   # стартовая страница (по умолчанию — ifconfig.me)
# BROWSER_RESOLUTION=1600x900   # разрешение виртуального дисплея (noVNC всё равно масштабирует)

# ════════════ ВЛОЖЕННЫЙ DOCKER ════════════
# Поднимается вместе со стеком. docker build/run/pull прямо из терминала IDE;
# трафик вложенных контейнеров идёт через туннель. Данные демона —
# в volume docker-data (очистка: docker compose down -v).
