# ── секреты и локальная конфигурация ──
.env

# ── wireguard: приватные ключи! ──
wireguard/**/*.conf
!wireguard/**/*.example.conf
wireguard/wg0.conf
wireguard/hooks/*
!wireguard/hooks/*.example

# ── данные пользователя IDE (токены claude, ssh-ключи и т.д.) ──
ide-home/

# ── пользовательские скрипты установки (install.d) ──
install.d/*.sh
!install.d/*.example*
!install.d/*.example.sh

# ── сборочный мусор ──
*.zip
*.vsix
__pycache__/
*.pyc

# ── редакторы и ОС ──
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
